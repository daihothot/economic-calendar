    "cn-gdp": {
      "provider": "dbnomics",
      "idPattern": "^cn-gdp-(?<year>\\d{4})-(?:q(?<quarter>[1-4])|(?<period>full-year))$",
      "frequency": "quarterly",
      "quarterAliases": {
        "full-year": 4
      },
      "sourceName": "中国国家统计局（NBS，经 DBnomics 获取）",
      "sourceUrl": "https://www.stats.gov.cn/sj/zxfb/",
      "metrics": [
        {
          "seriesId": "NBS/Q_A0103/A010301",
          "label": "当季实际 GDP 同比",
          "transformation": "value",
          "valueOffset": -100,
          "decimals": 1,
          "unit": "%",
          "showPlus": true
