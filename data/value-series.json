        {
          "seriesId": "NBS/Q_A0103/A010302",
          "label": "年内累计实际 GDP 同比",
          "transformation": "value",
          "valueOffset": -100,
          "decimals": 1,
          "unit": "%",
          "showPlus": true
        },
        {
          "seriesId": "NBS/Q_A0104/A010401",
          "label": "实际 GDP 环比",
          "transformation": "value",
          "decimals": 1,
          "unit": "%",
          "showPlus": true
        }
      ]
