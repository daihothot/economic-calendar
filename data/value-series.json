{
  "schemaVersion": 1,
  "providers": {
    "fred": {
      "kind": "fred-csv",
      "baseUrl": "https://fred.stlouisfed.org/graph/fredgraph.csv"
    },
    "dbnomics": {
      "kind": "dbnomics-json",
      "baseUrl": "https://api.db.nomics.world/v22/series/"
    },
    "chinamoney-lpr": {
      "kind": "chinamoney-lpr",
      "baseUrl": "https://www.chinamoney.com.cn/ags/ms/cm-u-bk-currency/LprHis?lang=CN"
    },
    "bls-public-api": {
      "kind": "bls-json",
      "baseUrl": "https://api.bls.gov/publicAPI/v2/timeseries/data/"
    },
    "none": {
      "kind": "none"
    }
  },
  "types": {
    "us-cpi": {
      "provider": "fred",
      "idPattern": "^us-cpi-(?<year>\\d{4})-(?<month>\\d{2})$",
      "frequency": "monthly",
      "sourceName": "美国劳工统计局（BLS，经 FRED 获取）",
      "sourceUrl": "https://www.bls.gov/cpi/",
      "metrics": [
        {
          "seriesId": "CPIAUCNS",
          "label": "CPI 同比",
          "transformation": "percent-change-year-over-year",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "CPIAUCSL",
          "label": "CPI 环比（季调）",
          "transformation": "percent-change",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "CPILFENS",
          "label": "核心 CPI 同比",
          "transformation": "percent-change-year-over-year",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "CPILFESL",
          "label": "核心 CPI 环比（季调）",
          "transformation": "percent-change",
          "decimals": 1,
          "unit": "%"
        }
      ]
    },
    "us-ppi": {
      "provider": "bls-public-api",
      "idPattern": "^us-ppi-(?<year>\\d{4})-(?<month>\\d{2})$",
      "frequency": "monthly",
      "sourceName": "美国劳工统计局（BLS）",
      "sourceUrl": "https://www.bls.gov/ppi/",
      "metrics": [
        {
          "seriesId": "WPUFD4",
          "label": "PPI 同比",
          "transformation": "percent-change-year-over-year",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "WPSFD4",
          "label": "PPI 环比（季调）",
          "transformation": "percent-change",
          "decimals": 1,
          "unit": "%"
        }
      ]
    },
    "us-pce": {
      "provider": "fred",
      "idPattern": "^us-pce-(?<year>\\d{4})-(?<month>\\d{2})$",
      "frequency": "monthly",
      "sourceName": "美国经济分析局（BEA，经 FRED 获取）",
      "sourceUrl": "https://www.bea.gov/data/personal-consumption-expenditures-price-index",
      "metrics": [
        {
          "seriesId": "PCEPI",
          "label": "PCE 物价指数同比",
          "transformation": "percent-change-year-over-year",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "PCEPILFE",
          "label": "核心 PCE 同比",
          "transformation": "percent-change-year-over-year",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "PCEPILFE",
          "label": "核心 PCE 环比",
          "transformation": "percent-change",
          "decimals": 1,
          "unit": "%"
        }
      ]
    },
    "us-nfp": {
      "provider": "fred",
      "idPattern": "^us-nfp-(?<year>\\d{4})-(?<month>\\d{2})$",
      "frequency": "monthly",
      "sourceName": "美国劳工统计局（BLS，经 FRED 获取）",
      "sourceUrl": "https://www.bls.gov/news.release/empsit.toc.htm",
      "metrics": [
        {
          "seriesId": "PAYEMS",
          "label": "非农就业变动",
          "transformation": "change",
          "decimals": 0,
          "unit": "千人",
          "showPlus": true
        },
        {
          "seriesId": "UNRATE",
          "label": "失业率",
          "transformation": "value",
          "decimals": 1,
          "unit": "%"
        },
        {
          "seriesId": "CES0500000003",
          "label": "平均时薪同比",
          "transformation": "percent-change-year-over-year",
          "decimals": 1,
          "unit": "%"
        }
      ]
    },
    "us-gdp": {
      "provider": "fred",
      "idPattern": "^us-gdp-(?<year>\\d{4})-q(?<quarter>[1-4])-(?:advance|second|third)$",
      "frequency": "quarterly",
      "freezeReleasedActual": true,
      "sourceName": "美国经济分析局（BEA，经 FRED 获取）",
      "sourceUrl": "https://www.bea.gov/data/gdp/gross-domestic-product",
      "metrics": [
        {
          "seriesId": "A191RL1Q225SBEA",
          "label": "实际 GDP 环比年化（当前官方修订值）",
          "transformation": "value",
          "decimals": 1,
          "unit": "%",
          "showPlus": true
        }
      ]
    },
    "us-ism-manufacturing": {
      "provider": "none",
      "sourceName": "美国供应管理协会（ISM）",
      "sourceUrl": "https://www.ismworld.org/supply-management-news-and-reports/reports/ism-pmi-reports/",
      "unavailableReason": "ISM PMI 属许可数据，FRED 序列已下架，免费镜像的制造业数值校验异常，暂不自动填充"
    },
    "us-ism-services": {
      "provider": "none",
      "sourceName": "美国供应管理协会（ISM）",
      "sourceUrl": "https://www.ismworld.org/supply-management-news-and-reports/reports/ism-pmi-reports/",
      "unavailableReason": "ISM PMI 属许可数据，免费公开源无法保证及时性和再分发权，暂不自动填充"
    },
    "us-fomc-decision": {
      "provider": "fred",
      "idPattern": "^us-fomc-(?<year>\\d{4})-(?<month>\\d{2})-decision$",
      "frequency": "monthly",
      "observationMode": "policy-decision",
      "lookaheadDays": 3,
      "sourceName": "美国联邦储备委员会（经 FRED 获取）",
      "sourceUrl": "https://www.federalreserve.gov/monetarypolicy/openmarket.htm",
      "metrics": [
        {
          "seriesId": "DFEDTARL",
          "label": "联邦基金目标区间下限",
          "transformation": "value",
          "decimals": 2,
          "unit": "%"
        },
        {
          "seriesId": "DFEDTARU",
          "label": "联邦基金目标区间上限",
          "transformation": "value",
          "decimals": 2,
          "unit": "%"
        }
      ]
    },
    "us-fed-press-conference": {
      "provider": "none",
      "sourceName": "美国联邦储备委员会（Federal Reserve）",
      "sourceUrl": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm",
      "forecastLine": "不适用（关注政策措辞）",
      "unavailableReason": "新闻发布会为非数值事件，不适用实际值和前值自动填充"
    },
    "us-fomc-minutes": {
      "provider": "none",
      "sourceName": "美国联邦储备委员会（Federal Reserve）",
