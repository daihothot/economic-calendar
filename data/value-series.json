          "unit": "%"
        },
        {
          "seriesId": "NBS/M_A010801/A01080101",
          "label": "PPI 同比",
          "transformation": "value",
          "valueOffset": -100,
          "decimals": 1,
          "unit": "%"
        }
      ]
